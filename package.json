{
  "name": "kill-team-mobile",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Phone-first digital tabletop for Warhammer 40,000 Kill Team (3rd edition, KT24)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && node tools/lint/no_math_random.mjs",
    "lint:rng": "node tools/lint/no_math_random.mjs",
    "e2e": "playwright test",
    "maps:extract": "python3 tools/maps/extract_cards.py",
    "maps:overlay": "python3 tools/maps/render_overlay.py",
    "maps:validate": "python3 tools/maps/validate_maps.py",
    "maps:test": "python3 tools/maps/test_extract.py",
    "teams:scrape": "python3 tools/teams/scrape_wahapedia.py",
    "teams:normalise": "python3 tools/teams/normalise.py",
    "soak": "vitest run tests/soak --reporter=basic"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "preact": "^10.25.1"
  }
}
